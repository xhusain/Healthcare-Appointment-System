PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/healthcare_appointments
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000

# Optional SMTP settings. Without SMTP_HOST, email uses a temporary demo mailbox.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Healthcare System <no-reply@example.com>"

# Required only when running the database seed/normalization scripts.
SEED_PASSWORD=replace-with-a-demo-password
ADMIN_PASSWORD=replace-with-an-admin-password
